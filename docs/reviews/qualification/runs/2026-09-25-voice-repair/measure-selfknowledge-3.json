       "gap_after_previous_ms": 0.0,
       "text_offset_before_ms": 1113.8,
       "text_offset_after_ms": 0.0
      },
      {
       "index": 4,
       "chars": 91,
       "text": "I cannot guarantee an exact instant, but I aim to respond promptly and without undue delay.",
       "duration_s": 6.24,
       "arrived_ms": 20007.1,
       "playback_start_ms": 28547.7,
       "waited_for_previous_ms": 8540.6,
       "gap_after_previous_ms": 0.0,
