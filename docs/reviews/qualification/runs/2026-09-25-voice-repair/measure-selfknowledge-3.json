       "text_offset_before_ms": 8073.8,
       "text_offset_after_ms": 0.0
      },
      {
       "index": 2,
       "chars": 41,
       "text": "usually within the span of a few seconds.",
       "duration_s": 2.4,
       "arrived_ms": 13568.9,
       "playback_start_ms": 16627.7,
       "waited_for_previous_ms": 3058.8,
       "gap_after_previous_ms": 0.0,
       "text_offset_before_ms": 3513.8,
       "text_offset_after_ms": 0.0
      },
      {
       "index": 3,
       "chars": 177,
       "text": "In practice, from the moment your words cease I tend to start formulating and voicing a response in roughly six to thirteen seconds, depending on the complexity of what you ask.",
       "duration_s": 9.52,
       "arrived_ms": 17331.1,
       "playback_start_ms": 19027.7,
