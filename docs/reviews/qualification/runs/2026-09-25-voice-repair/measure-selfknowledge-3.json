     },
     "segments": [
      {
       "index": 1,
       "chars": 43,
       "text": "I do not keep a live counter for each turn,",
       "duration_s": 2.56,
       "arrived_ms": 10074.0,
       "playback_start_ms": 10074.0,
       "waited_for_previous_ms": 0.0,
