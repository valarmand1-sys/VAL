     },
     "segments": [
      {
       "index": 1,
       "chars": 71,
       "text": "My lord, I generally begin my reply shortly after you finish speaking \u2013",
       "duration_s": 4.56,
       "arrived_ms": 12067.7,
       "playback_start_ms": 12067.7,
       "waited_for_previous_ms": 0.0,
