       "text_offset_before_ms": 6623.8,
       "text_offset_after_ms": 0.0
      },
      {
       "index": 2,
       "chars": 188,
       "text": "The system\u2019s test runs show a typical window from your spoken input to my first voiced word of about 6\u201313\u202fseconds, but I have no real\u2011time clock to give a precise number for this instance.",
       "duration_s": 10.08,
       "arrived_ms": 17986.7,
       "playback_start_ms": 17986.7,
       "waited_for_previous_ms": 0.0,
       "gap_after_previous_ms": 893.7,
       "text_offset_before_ms": 2690.1,
       "text_offset_after_ms": 0.0
      },
      {
       "index": 3,
       "chars": 108,
       "text": "Your wifi does not affect me; all processing and voice synthesis occur locally on the machine you are using.",
       "duration_s": 6.0,
       "arrived_ms": 20596.0,
       "playback_start_ms": 28066.7,
       "waited_for_previous_ms": 7470.7,
       "gap_after_previous_ms": 0.0,
       "text_offset_before_ms": -7389.9,
       "text_offset_after_ms": 0.0
      }
     ]
    },
    {
     "phrase": "What could we change on my side to make you respond in about a second?",
     "speech_end_to": {
      "endpoint_seen": 995.8,
      "words_provisional_after": 995.8,
      "committed_seen": 2107.5,
