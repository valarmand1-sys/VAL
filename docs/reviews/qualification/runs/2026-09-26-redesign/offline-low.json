      "first_playback_start": 8437.6
     },
     "segments": [
      {
       "index": 1,
       "chars": 56,
       "text": "My lord, I\u2019m unable to place the booking at this moment.",
       "message_id": "00000000-0000-0000-0000-000000000000",
       "pieces": 4,
       "underrun_ms": 0.0,
       "duration_s": 3.76,
       "arrived_ms": 8437.6,
