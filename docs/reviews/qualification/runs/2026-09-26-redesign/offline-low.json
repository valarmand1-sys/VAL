      },
      {
       "index": 2,
       "chars": 29,
       "text": "How may I assist you tonight?",
       "message_id": "01a0e01f-d4a2-7bb5-8a68-5858efa8b5f2",
       "pieces": 2,
       "underrun_ms": 0.0,
       "duration_s": 1.52,
