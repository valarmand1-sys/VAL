       "text_offset_before_ms": 2947.4,
       "text_offset_after_ms": 0.0
      }
     ],
     "group": "ineligible"
    },
    {
     "phrase": "Evening to you, Val.",
     "speech_end_to": {
      "endpoint_seen": 1044.7,
      "words_provisional_after": 1044.7,
      "committed_seen": 2184.4,
      "owner_message_canonical": 2195.6,
