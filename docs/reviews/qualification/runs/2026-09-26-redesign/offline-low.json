       "gap_after_previous_ms": null,
       "text_offset_before_ms": 5107.6,
       "text_offset_after_ms": 208.2
      },
      {
       "index": 2,
       "chars": 137,
       "text": "To proceed I would need a clear record of what is being reserved\u2014room, equipment, or an appointment slot\u2014and the desired dates and times.",
       "message_id": "01a0e020-990f-770a-a5b6-92096f0f495f",
       "pieces": 9,
       "underrun_ms": 0.0,
       "duration_s": 8.32,
