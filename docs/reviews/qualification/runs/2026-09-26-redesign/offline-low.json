       "text_offset_before_ms": 1347.6,
       "text_offset_after_ms": 0.0
      },
      {
       "index": 3,
       "chars": 73,
       "text": "Once that information is in the house\u2019s record, I can arrange it for you.",
       "message_id": "01a0e020-990f-770a-a5b6-92096f0f495f",
       "pieces": 4,
       "underrun_ms": 0.0,
       "duration_s": 3.68,
