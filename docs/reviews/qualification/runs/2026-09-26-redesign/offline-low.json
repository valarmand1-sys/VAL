     },
     "segments": [
      {
       "index": 1,
       "chars": 13,
       "text": "Yes, my lord.",
       "message_id": "00000000-0000-0000-0000-000000000000",
       "pieces": 2,
       "underrun_ms": 0.0,
       "duration_s": 1.12,
       "arrived_ms": 16753.8,
