       "text_offset_after_ms": 0.0
      },
      {
       "index": 3,
       "chars": 121,
       "text": "If you wish for a quicker dialogue, the only levers available are to shorten your own remarks or ask for briefer replies.",
       "message_id": "01a0dc1f-5ce2-7a9c-b5bb-e5e003ee1128",
