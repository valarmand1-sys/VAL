# Val — environment.
#
# Copy to `.env` and fill in the values. `.env` is ignored by git and cannot be
# committed; `git add .env` is refused. This file is committed and must never
# hold a value for any secret variable — `infrastructure/ci/check_secrets.py`
# fails the build if one appears.
#
#     cp .env.example .env
#
# Shell scripts load it with `set -a; . ./.env; set +a`. Python reads the same
# variables from the environment at startup, never from a literal in source.
#
# One secret is deliberately NOT here: the backup encryption passphrase. It lives
# in the macOS login Keychain, so that it is not in the same place as anything
# else and not in a file at all. See docs/BACKUP.md.

# --- The authoritative store ------------------------------------------------
# Val's PostgreSQL runs on port 5433. Port 5432 is a separate instance that has
# nothing to do with this project.

VAL_DATABASE_URL=postgresql+psycopg://localhost:5433/val
VAL_TEST_DATABASE_URL=postgresql+psycopg://localhost:5433/val_test

# --- Backblaze B2, the backup destination -----------------------------------
# Bucket is already created. Endpoint and region are shown on the bucket's page
# in the B2 console; the endpoint looks like s3.us-west-004.backblazeb2.com and
# the region is the middle segment of it, us-west-004.

VAL_B2_BUCKET=valbackup
VAL_B2_ENDPOINT=
VAL_B2_REGION=

# The application key pair, created in B2 under Application Keys. Restrict it to
# the valbackup bucket. These two are secrets.

VAL_B2_KEY_ID=
VAL_B2_APPLICATION_KEY=

# --- Backup alerting --------------------------------------------------------
# Where a failed or overdue backup reports to. Not a secret.

VAL_BACKUP_ALERT_EMAIL=
