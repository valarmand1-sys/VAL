# Val — environment.
#
# Copy to `.env` and fill in the values. `.env` is ignored by git and cannot be
# committed; `git add .env` is refused. This file is committed and must never
# hold a value for any secret variable — `infrastructure/ci/check_secrets.py`
# fails the build if one appears.
#
#     cp .env.example .env
#
# Shell scripts load it with `set -a; . ./.env; set +a`. Python reads the same
# variables from the environment at startup, never from a literal in source.
#
# BACKUP SECRETS ARE NOT HERE. The B2 credentials and the repository encryption
# passphrase live in /opt/homebrew/etc/pgbackrest/pgbackrest.conf, because
# PostgreSQL's archive_command runs as the server process and cannot read this
# file. Holding them in both places would put the same secret in two files.
# Val's model provider credentials do belong here, and arrive at WP-0.4.

# --- The authoritative store ------------------------------------------------
# Val's PostgreSQL runs on port 5433. Port 5432 is a separate instance that has
# nothing to do with this project.

VAL_DATABASE_URL=postgresql+psycopg://localhost:5433/val
VAL_TEST_DATABASE_URL=postgresql+psycopg://localhost:5433/val_test

# --- Backup alerting --------------------------------------------------------
# Where an overdue or failing backup reports to. Not a secret.

VAL_BACKUP_ALERT_EMAIL=

# --- Model providers (WP-0.4) -----------------------------------------------
# Only providers ruled Protected-eligible on 15 August 2026 may be configured
# (01-architecture.md §5.4). Two are required; the third is optional.
#
# Anthropic and OpenAI are eligible outright. Gemini is eligible ONLY on a paid
# billing account, and startup verifies that against Google rather than trusting
# this file — an unbilled key fails startup rather than silently sending
# Protected content somewhere human reviewers may read it.
#
# CORRECTED 17 August 2026. This file previously said a blank key merely leaves
# that provider unconfigured. That is not what happens.
#
#   A key is required for every provider the Model Configuration Registry has an
#   active route for, and STARTUP REFUSES TO RUN without it.
#
# The registry currently carries active routes on anthropic (opus-5, haiku-4-5)
# and openai (gpt-5-5), so BOTH of the first two variables below are required.
# Leaving either blank stops the service with a message naming the variable.
#
# The refusal is deliberate: running with a configured route silently missing
# would make "swapping the configured provider requires no change outside
# configuration" untrue in exactly the way that is hardest to notice — the
# fallback would quietly never be reachable, and nothing would say so.
#
# VAL_GOOGLE_API_KEY is genuinely optional, because the registry carries no
# active Google route. Adding one makes the key required on the same terms, and
# startup would additionally refuse until paid billing is verified.

VAL_ANTHROPIC_API_KEY=
VAL_OPENAI_API_KEY=
VAL_GOOGLE_API_KEY=
